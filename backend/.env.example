# Copy to .env and fill in. Everything here is optional - with no values the
# app runs on SQLite and uses deterministic fallbacks for the AI features.

# Database. SQLite by default; point at Postgres for production, e.g.
#   postgresql+psycopg://user:pass@localhost:5432/lightwork
DATABASE_URL=sqlite:///./lightwork.db

# Kimi / Moonshot API. Leave blank to run fully offline (deterministic brief,
# ask, and act). The key stays server-side and is never sent to the browser.
KIMI_API_KEY=
KIMI_BASE=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-32k
KIMI_MODEL_ASK=moonshot-v1-32k

# CORS. "*" is fine for local dev; lock this down in production.
CORS_ORIGINS=*
